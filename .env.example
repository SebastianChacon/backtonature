# URL canónica del sitio. En Vercel se puede dejar sin definir en preview.
NEXT_PUBLIC_SITE_URL=https://backtonature.net

# Google Analytics 4 — el ID real del sitio actual.
# Déjalo vacío en desarrollo para no contaminar las métricas.
NEXT_PUBLIC_GA_ID=

# Envío de formularios (Contact / Careers / Subscribe).
# Sin estas variables los formularios validan y responden, pero solo registran
# el envío en el log del servidor en lugar de mandar el email.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=web@backtonature.net
CONTACT_TO_EMAIL=info@backtonature.net
